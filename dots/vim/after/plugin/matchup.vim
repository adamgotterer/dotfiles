" non-cursor matches: bold, underline
highlight! MatchParen     ctermfg=NONE ctermbg=NONE cterm=bold,underline  gui=bold,underline

" the one under the cursor: bold
highlight! MatchParenCur  ctermfg=NONE ctermbg=NONE cterm=bold gui=bold

" word-style matches: undercurl in GUI
highlight! MatchWordCur   ctermfg=NONE ctermbg=NONE cterm=bold  gui=bold guisp=#C8A2C8
