extract () {
    if [ -f $1 ]; then
        case $1 in
            *.tar.bz2)  tar -jxvf $1                        ;;
            *.tar.gz)   tar -zxvf $1                        ;;
            *.bz2)      bunzip2 $1                          ;;
            *.dmg)      hdiutil mount $1                    ;;
            *.gz)       gunzip $1                           ;;
            *.tar)      tar -xvf $1                         ;;
            *.tbz2)     tar -jxvf $1                        ;;
            *.tgz)      tar -zxvf $1                        ;;
            *.zip)      unzip $1                            ;;
            *.ZIP)      unzip $1                            ;;
            *.pax)      cat $1 | pax -r                     ;;
            *.pax.Z)    uncompress $1 --stdout | pax -r     ;;
            *.rar)      unrar x $1                          ;;
            *.Z)        uncompress $1                       ;;
            *)          echo -e "${RED}Error: '$1' cannot be extracted/mounted via extract()${NC}" ;;
        esac
    else
        echo "${RED}Error: '$1' is not a valid file${NC}"
    fi
}

function mk() {
	mkdir -p "$@" && cd "$@"
}

# Claude Code acting as the analect-agent GitHub App (plain `claude` stays you) (see doc/github-app.md in the analect
# checkout). The token is minted on each call; no secret lives in this file.
claude-analect() {
  local slug="analect-agent" email="338268207+analect-agent[bot]@users.noreply.github.com" checkout="$HOME/Sites/analect"
  GH_TOKEN=analect-app \
  PATH="$checkout/bin/shims:$PATH" \
  GIT_TERMINAL_PROMPT=0 \
  GIT_AUTHOR_NAME="${slug}[bot]" GIT_COMMITTER_NAME="${slug}[bot]" \
  GIT_AUTHOR_EMAIL="$email" GIT_COMMITTER_EMAIL="$email" \
  GIT_CONFIG_COUNT=3 \
  GIT_CONFIG_KEY_0=url.https://github.com/.insteadOf GIT_CONFIG_VALUE_0=git@github.com: \
  GIT_CONFIG_KEY_1=credential.https://github.com.helper GIT_CONFIG_VALUE_1= \
  GIT_CONFIG_KEY_2=credential.https://github.com.helper GIT_CONFIG_VALUE_2='!'"$checkout/bin/app-token credential" \
  claude "$@"
}
